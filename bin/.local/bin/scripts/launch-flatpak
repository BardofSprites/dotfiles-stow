#!/usr/bin/env bash

declare -A flatpaks=(
    [Anki]="net.ankiweb.Anki"
    [Audacity]="org.audacityteam.Audacity"
    [Calibre]="com.calibre_ebook.calibre"
    [Chromium]="org.chromium.Chromium"
    [Discord]="com.discordapp.Discord"
    [Feishin]="org.jeffvli.feishin"
    [FreeTube]="io.freetubeapp.FreeTube"
    [Gajim]="org.gajim.Gajim"
    [GIMP]="org.gimp.GIMP"
    [Inkscape]="org.inkscape.Inkscape"
    [Kdenlive]="org.kde.kdenlive"
    [LibreOffice]="org.libreoffice.LibreOffice"
    [OBS]="com.obsproject.Studio"
    [Qutebrowser]="org.qutebrowser.qutebrowser"
    [Steam]="com.valvesoftware.Steam"
    [TeXmacs]="org.texmacs.TeXmacs"
    [Zeal]="org.zealdocs.Zeal"
)

chosen=$(printf '%s\n' "${!flatpaks[@]}" | sort | dmenu -i)

[[ -z "$chosen" ]] && exit 0

app_id="${flatpaks[$chosen]}"

if [[ -z "$app_id" ]]; then
    echo "Unknown selection: $chosen" >&2
    exit 1
fi

flatpak run "$app_id"
