[memory]
command=~/.local/bin/scripts/status/memory
interval=10

[internet]
command=~/.local/bin/scripts/status/internet
interval=10

[weather]
command=~/.local/bin/scripts/status/weather
interval=18000
signal=5

[volume-pulseaudio]
command=~/.local/bin/scripts/status/volume-pw
interval=1
signal=1

[music]
command=~/.local/bin/scripts/status/music
interval=5

[time]
command=~/.local/bin/scripts/status/time-clock
interval=1
markup=pango